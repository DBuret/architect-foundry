' Style des diagrammes de composants, de classes et de déploiement.
' Voir normes/schemas.adoc.
' Usage : !include normes/plantuml/_component.iuml, juste après @startuml.

!include _commun.iuml

skinparam componentStyle rectangle

' Palette de _palette.iuml (normes/schemas.adoc, « Couleurs des schémas ») :
' éléments blancs bordés de gris, cadres en conteneur gris pâle. Sans ces
' valeurs, PlantUML borde tout de #181818, presque noir.
!$elements = %splitstr("component,database,queue,rectangle,interface,actor,artifact,storage,collections,card,file,class", ",")
!$cadres = %splitstr("package,node,frame,folder,cloud", ",")
!foreach $e in $elements
skinparam $e {
  BackgroundColor $element_fond
  BorderColor $element_bord
}
!endfor
!foreach $e in $cadres
skinparam $e {
  BackgroundColor $conteneur_fond
  BorderColor $conteneur_bord
}
!endfor

' Couleurs nommées (<<vert>>, <<peche>>…) et mise en évidence (<<focus>>,
' <<urgent>>), sur les éléments comme sur les cadres.
$stereos_couleurs(%splitstr("component,database,queue,rectangle,actor,artifact,storage,collections,card,file,class,package,node,frame,folder,cloud", ","))
$stereos_marques(%splitstr("component,database,queue,rectangle,actor,artifact,storage,collections,card,file,class,package,node,frame,folder,cloud", ","))
